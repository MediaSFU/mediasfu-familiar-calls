{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "familiar-call": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/familiar-call",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["node_modules/bootstrap/dist/css/bootstrap.min.css", "src/styles.css"]
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all", "sourceMap": false }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": { "production": { "buildTarget": "familiar-call:build:production" } },
          "defaultConfiguration": "production"
        }
      }
    },
    "familiar-call-whip-whep": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/familiar-call-whip-whep",
            "index": "src/whip-whep-index.html",
            "browser": "src/whip-whep-main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["../whip-whep/src/styles.css"]
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all", "sourceMap": false }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "familiar-call-whip-whep:build:production" }
          },
          "defaultConfiguration": "production",
          "options": { "proxyConfig": "proxy.conf.cjs" }
        }
      }
    }
  }
}
